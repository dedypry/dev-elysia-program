rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mail SMTP + recipient (app baca tanpa login; tulis hanya lewat Console / Admin)
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
